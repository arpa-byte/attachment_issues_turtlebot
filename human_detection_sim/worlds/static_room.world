<?xml version="1.0" ?>
<!-- static_room.world.xacro (patched) -->
<sdf version="1.7" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <world name="static_room">

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- GROUND -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.6 2.25</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls (unchanged) -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 1.125 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.6 0.05 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.6 0.05 0.4</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -1.125 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.6 0.05 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.6 0.05 0.4</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>1.8 0 0.2 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.25 0.05 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.25 0.05 0.4</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-1.8 0 0.2 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.25 0.05 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.25 0.05 0.4</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- HUMAN 1: OWNER (RED) -->
<model name="human1">
  <static>true</static>
  
  <pose>-1.0 -1.0 0 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <cylinder>
          <radius>0.10</radius>
          <length>0.50</length>
        </cylinder>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.10</radius>
          <length>0.50</length>
        </cylinder>
      </geometry>
      <material><script><name>Gazebo/Blue</name></script></material>
    </visual>
  </link>
</model>


    <!-- HUMAN 2: STRANGER (BLUE) -->
<model name="human2">
  <static>true</static>
  <pose>1.0 -1.0 0 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <cylinder>
          <radius>0.10</radius>
          <length>0.50</length>
        </cylinder>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.10</radius>
          <length>0.50</length>
        </cylinder>
      </geometry>
      <material><script><name>Gazebo/Red</name></script></material>
    </visual>
  </link>
</model>


    <!-- Toy -->
<model name="toy">
  <static>true</static>
  <pose>1.0 1.0 0.25 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <box><size>0.1 0.1 0.3</size></box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box><size>0.1 0.1 0.3</size></box>
      </geometry>
      <material><script><name>Gazebo/Green</name></script></material>
    </visual>
  </link>
</model>


    <!-- TurtleBot3 -->
    <include>
      <uri>model://turtlebot3_burger</uri>
      <pose>-0.5 0.5 0 0 0 0</pose>
    </include>

    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

  </world>

  <physics type="ode">
    <gravity>0 0 -9.8</gravity>
    <real_time_update_rate>1000.0</real_time_update_rate>
  </physics>

</sdf>
