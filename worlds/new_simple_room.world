<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="new_simple_room">

    <!-- Sun Light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- GROUND: 3.6 x 2.25 m -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.6 2.25</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- NORTH WALL -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 1.125 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.6 0.05 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.6 0.05 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>


    <!-- SOUTH WALL -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -1.125 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.6 0.05 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.6 0.05 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>


    <!-- EAST WALL -->
    <model name="east_wall">
      <static>true</static>
      <pose>1.8 0 0.5 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.25 0.05 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.25 0.05 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- WEST WALL -->
    <model name="west_wall">
      <static>true</static>
      <pose>-1.8 0 0.5 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.25 0.05 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.25 0.05 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>


    <!-- TOY: Red Cube -->
    <model name="toy">
      <static>true</static>
      <pose>0.8 0.6 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>
    
<!-- HUMAN OWNER -->
<model name="human_owner">
  <!-- Place the model exactly at ground level -->
  <pose>0 2.5 0 0 0 0</pose>
  <static>false</static>

  <!-- ================= BODY ================= -->
  <link name="body">
    <pose>0 0 0.75 0 0 0</pose> <!-- body center is 0.75m above ground -->

    <inertial>
      <mass>30</mass>
      <inertia>
        <ixx>1.2</ixx>
        <iyy>1.2</iyy>
        <izz>0.2</izz>
      </inertia>
    </inertial>

    <collision name="body_collision">
      <geometry>
        <cylinder>
          <radius>0.18</radius>
          <length>1.50</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="body_visual">
      <geometry>
        <cylinder>
          <radius>0.18</radius>
          <length>1.50</length>
        </cylinder>
      </geometry>
      <material><ambient>0 0 1 1</ambient></material>
    </visual>
  </link>

  <!-- ================= LEFT WHEEL ================= -->
  <link name="left_wheel">
    <pose>-0.20 0 0.05 0 1.57 0</pose> <!-- slight lift, touching ground -->

    <inertial>
      <mass>2</mass>
      <inertia>
        <ixx>0.005</ixx>
        <iyy>0.005</iyy>
        <izz>0.005</izz>
      </inertia>
    </inertial>

    <collision name="left_wheel_collision">
      <geometry>
        <cylinder>
          <radius>0.08</radius>
          <length>0.04</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="left_wheel_visual">
      <geometry>
        <cylinder>
          <radius>0.08</radius>
          <length>0.04</length>
        </cylinder>
      </geometry>
      <material><ambient>0 0 1 1</ambient></material>
    </visual>
  </link>

  <!-- ================= RIGHT WHEEL ================= -->
  <link name="right_wheel">
    <pose>0.20 0 0.05 0 1.57 0</pose>

    <inertial>
      <mass>2</mass>
      <inertia>
        <ixx>0.005</ixx>
        <iyy>0.005</iyy>
        <izz>0.005</izz>
      </inertia>
    </inertial>

    <collision name="right_wheel_collision">
      <geometry>
        <cylinder>
          <radius>0.08</radius>
          <length>0.04</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="right_wheel_visual">
      <geometry>
        <cylinder>
          <radius>0.08</radius>
          <length>0.04</length>
        </cylinder>
      </geometry>
      <material><ambient>0 0 1 1</ambient></material>
    </visual>
  </link>

  <!-- ================ JOINTS ================= -->
  <joint name="body_left_wheel_joint" type="revolute">
    <parent>body</parent>
    <child>left_wheel</child>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <joint name="body_right_wheel_joint" type="revolute">
    <parent>body</parent>
    <child>right_wheel</child>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- =============== DIFF DRIVE ================= -->
  <plugin name="diff_drive_human_owner" filename="libgazebo_ros_diff_drive.so">
    <ros>
      <namespace>/human_owner</namespace>
      <argument>~/cmd_vel:=cmd_vel</argument>
    </ros>

    <wheel_separation>0.40</wheel_separation>
    <wheel_diameter>0.16</wheel_diameter>

    <left_joint>body_left_wheel_joint</left_joint>
    <right_joint>body_right_wheel_joint</right_joint>

    <publish_tf>true</publish_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
    <update_rate>50</update_rate>
  </plugin>

</model>

    <!-- HUMAN STRANGER -->
    <model name="human_stranger">
      <pose>2 0.2 0 0 0 0</pose>
      <static>false</static>

      <!-- Body -->
      <link name="body">
        <visual name="body_visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>   <!-- half of width -->
              <length>1.5</length>    <!-- height -->
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
          </material>
        </visual>

        <collision name="body_collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Left Wheel -->
      <link name="left_wheel">
        <pose>-0.25 0 0.75 0 1.57 0</pose>
        <visual name="left_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
          </material>
        </visual>

        <collision name="left_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Right Wheel -->
      <link name="right_wheel">
        <pose>0.25 0 0.75 0 1.57 0</pose>
        <visual name="right_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
          </material>
        </visual>

        <collision name="right_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Left Joint -->
      <joint name="body_left_wheel_joint" type="revolute">
        <parent>body</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>

      <!-- Right Joint -->
      <joint name="body_right_wheel_joint" type="revolute">
        <parent>body</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>

      <!-- Diff Drive -->
      <plugin name="diff_drive_human_stranger" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/human_stranger</namespace>
          <argument>~/cmd_vel:=cmd_vel</argument>
        </ros>
        <wheel_separation>0.5</wheel_separation>
        <wheel_diameter>0.2</wheel_diameter>
        <left_joint>body_left_wheel_joint</left_joint>
        <right_joint>body_right_wheel_joint</right_joint>

        <publish_tf>true</publish_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <update_rate>20</update_rate>
      </plugin>
    </model>


    <!-- ROBOT: TurtleBot3 Burger -->
    <include>
      <uri>model://turtlebot3_burger</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Physics -->
    <physics type="ode">
      <gravity>0 0 -9.8</gravity>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

  </world>
</sdf>
